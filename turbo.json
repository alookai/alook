{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "source": {
      "dependsOn": [
        "^source"
      ]
    },
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**"
      ],
      "env": [
        "ALOOK_TASK_BUN"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/scripts/ci/run-turbo.mjs"
      ]
    },
    "test": {
      "dependsOn": [
        "^source"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/vitest.shared.ts",
        "$TURBO_ROOT$/vitest.config.ts"
      ],
      "outputs": []
    },
    "test:runtime": {
      "dependsOn": [
        "^source"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/vitest.shared.ts",
        "$TURBO_ROOT$/vitest.config.ts"
      ],
      "outputs": [],
      "cache": false
    },
    "typecheck": {
      "dependsOn": [
        "^source"
      ],
      "inputs": [
        "$TURBO_DEFAULT$"
      ]
    },
    "lint": {
      "dependsOn": [
        "^source"
      ]
    },
    "knip": {
      "dependsOn": [
        "^source"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "@alook/web#typecheck": {
      "dependsOn": [
        "^source"
      ],
      "inputs": [
        "package.json",
        "tsconfig*.json",
        "eslint.config.mjs",
        "vitest*.{ts,mts}",
        "src/**",
        "scripts/**",
        "public/**",
        "test-runtime/**",
        "migrations/**",
        "custom-worker.ts",
        "next.config.ts",
        "open-next.config.ts",
        "postcss.config.mjs",
        "wrangler*.toml",
        "readme-capture/**",
        "app-store-capture/**",
        "$TURBO_ROOT$/vitest.shared.ts",
        "$TURBO_ROOT$/vitest.config.ts",
        "cloudflare-env.d.ts",
        "!**/{node_modules,.next,.open-next,.wrangler,.turbo,dist,coverage}/**",
        "!**/{test-results,blob-report,e2e-service-logs,e2e-shard-manifest,.auth}/**",
        "!public/sw.js",
        "!public/sw.js.map",
        "!public/community-shell/**",
        "!**/*.tsbuildinfo",
        "!blog/package.json",
        "!blog/public/alook.svg",
        "!blog/public/apple-touch-icon.png",
        "!blog/public/favicon.ico",
        "!blog/public/icon-192.png",
        "!blog/public/fonts/dm-sans-600.ttf",
        "open-next-worker.d.ts",
        "open-next-handler.d.ts"
