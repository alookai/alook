{
  "name": "@alook/daemon",
  "version": "0.1.32",
  "description": "Alook agent daemon — host-side runtime backend, process manager, credential proxy, and control plane.",
  "license": "Apache-2.0",
  "homepage": "https://github.com/alookai/alook#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alookai/alook.git",
    "directory": "src/daemon"
  },
  "bugs": {
    "url": "https://github.com/alookai/alook/issues"
  },
  "keywords": [
    "alook",
    "daemon",
    "ai",
    "agent",
    "email"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "alook-daemon": "dist/cli/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.9"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prebuild": "pnpm -C agent-driver run build",
    "build": "bun build src/index.ts --outdir dist --target node --format esm --external commander --external ws --external sharp && bun build src/cli/index.ts --outdir dist/cli --target node --format esm --external commander --external ws --external sharp && node scripts/prepare-dist.mjs",
    "prepack": "pnpm run build",
    "typecheck": "tsc --noEmit",
    "test": "pnpm test:unit && pnpm test:packed",
    "test:unit": "vitest run --exclude src/version.packed.test.ts --exclude src/agent-driver-bundle.packed.test.ts --exclude src/cli/daemonSelfUpdate.real.test.ts",
    "test:packed": "vitest run --no-file-parallelism src/version.packed.test.ts src/agent-driver-bundle.packed.test.ts src/cli/daemonSelfUpdate.real.test.ts",
    "test:watch": "vitest",
    "test:integration": "vitest run --config ../../tests/integration/daemon/vitest.config.ts --passWithNoTests",
    "lint": "eslint .",
    "daemon": "tsx scripts/daemon.ts"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "sharp": "^0.35.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@alook/agent-driver": "workspace:*",
    "@alook/shared": "workspace:*",
    "@types/node": "^20.0.0",
    "@types/ws": "^8.18.1",
    "eslint": "^9.39.5",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10"
  }
}
