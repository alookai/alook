{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "scripts/**/*.{ts,mjs}",
    "src/service-supervisor.ts"
  ],
  "project": ["src/**/*.ts"],
  "ignoreDependencies": [
    "sharp",
    "ws"
  ],
  "ignoreBinaries": [
    "predev",
    "printf",
    "pbcopy",
    "xclip"
  ],
  "vitest": {
    "entry": ["test/**/*.test.ts"]
  },
  "eslint": {
    "entry": ["eslint.config.mjs"]
  }
}
