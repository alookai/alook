{
  "name": "@alook/page-host",
  "version": "0.1.72",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare:upstream": "node scripts/prepare.mjs",
    "build": "node scripts/build.mjs",
    "test": "vitest run --config vitest.config.ts",
    "lint": "eslint src/ scripts/ --max-warnings=0",
    "dev": "node ../../scripts/dev-with-wrangler-registry.mjs ../../.wrangler/registry wrangler dev --port 8795 --persist-to .state",
    "deploy": "wrangler deploy",
    "test:native": "pnpm --filter @alook/agent-driver build && pnpm --filter @alook/daemon build && node scripts/build.mjs && node --experimental-strip-types test-runtime/native.mjs"
  },
  "devDependencies": {
    "eslint": "^9.39.5",
    "vitest": "5.1.1",
    "wrangler": "4.165.0"
  }
}
