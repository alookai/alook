{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "external-links",
  "description": "System handler access for HTTP(S), mailto, and tel links in the main webview",
  "windows": ["main"],
  "platforms": ["linux", "macOS", "windows", "android", "iOS"],
  "local": false,
  "remote": {
    "urls": ["https://alook.ai"]
  },
  "permissions": [
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "http://*" },
        { "url": "https://*" },
        { "url": "mailto:*" },
        { "url": "tel:*" }
      ]
    }
  ]
}
