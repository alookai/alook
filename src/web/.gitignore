# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# playwright (E2E UI) artifacts + saved auth state
/test-results/
/playwright-report/
/blob-report/
/e2e-service-logs/
/playwright/.cache/
src/test/e2e-ui/.auth/
# local-run D1/DO state backup taken by the E2E harness
.wrangler/state.e2e-backup/

# next.js
/.next/
/blog/.next/
/blog/.open-next/
/blog/package.json
/blog/public/alook.svg
/blog/public/apple-touch-icon.png
/blog/public/favicon.ico
/blog/public/icon-192.png
/blog/public/fonts/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
