{
	"extends": "../tsconfig.json",
	"compilerOptions": {
		"paths": {
			"@/*": ["../src/*"],
			"@blog/*": ["./src/*"]
		},
		"plugins": [{ "name": "next" }],
		"tsBuildInfoFile": "./.next/cache/tsconfig.tsbuildinfo",
		"types": ["./cloudflare-env.d.ts", "node"]
	},
	"include": [
		"next-env.d.ts",
		"**/*.ts",
		"**/*.tsx",
		"**/*.mdx",
		".next/types/**/*.ts",
		".next/dev/types/**/*.ts"
	],
	"exclude": ["../node_modules", "**/*.test.ts", "**/*.test.tsx"]
}
