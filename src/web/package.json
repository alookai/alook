{
  "name": "@alook/web",
  "version": "0.1.29",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev-zones.mjs",
    "dev:main": "node ../../scripts/dev-with-wrangler-registry.mjs ../../.wrangler/registry next dev --hostname 127.0.0.1 --port 3001",
    "dev:blog": "node ../../scripts/dev-with-wrangler-registry.mjs ../../.wrangler/registry next dev blog --hostname 127.0.0.1 --port 3002",
    "dev:zones:worker": "node scripts/dev-zones.mjs --worker",
    "build": "next build",
    "build:blog:next": "tsx blog/scripts/stage-shared-assets.ts && next build blog && tsx blog/scripts/prepare-open-next-standalone.ts",
    "build:blog": "tsx blog/scripts/stage-shared-assets.ts && opennextjs-cloudflare build --config blog/wrangler.toml --openNextConfigPath blog/open-next.config.ts",
    "validate:blog": "tsx blog/scripts/validate-blog-assets.ts",
    "verify:blog-dry-run": "tsx scripts/verify-blog-dry-run.ts",
    "verify:zone-output": "tsx scripts/verify-zone-output.ts",
    "preflight:bug-reports": "tsx scripts/preflight-bug-reports.ts",
    "start": "next start",
    "lint": "eslint src/ blog/ scripts/",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "deploy:blog": "pnpm build:blog && opennextjs-cloudflare deploy --config blog/wrangler.toml",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "upload:blog": "pnpm build:blog && opennextjs-cloudflare upload --config blog/wrangler.toml",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv ./cloudflare-env.d.ts",
    "test": "vitest run --config vitest.workspace.config.ts",
    "test:watch": "vitest",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:e2e-ui": "playwright test",
    "test:e2e-ui:headed": "playwright test --headed",
    "knip": "knip",
    "seed:stress": "tsx scripts/seed-stress.ts",
    "perf:switch": "tsx scripts/perf-report.ts --clear && playwright test --config playwright.perf.config.ts && tsx scripts/perf-report.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p blog/tsconfig.json",
    "seo:check": "lhci autorun --config=lighthouserc.json && node scripts/print-lighthouse-scores.mjs"
  },
  "dependencies": {
    "@alook/shared": "workspace:*",
    "@atlaskit/pragmatic-drag-and-drop": "3.0.0",
    "@atlaskit/pragmatic-drag-and-drop-auto-scroll": "3.1.0",
    "@atlaskit/pragmatic-drag-and-drop-hitbox": "2.1.0",
