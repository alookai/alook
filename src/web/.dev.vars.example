# =============================================================================
# Cloudflare Worker Bindings — Local Development
# =============================================================================
# Copy this file to .dev.vars and fill in your values.
# Wrangler reads .dev.vars automatically for local dev secrets.
# NEVER commit .dev.vars — it contains real secrets.
# =============================================================================

# Session signing secret (generate with: openssl rand -base64 32)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Encryption key for credentials and device tokens (generate with: openssl rand -base64 32)
ENCRYPTION_KEY=

# GitHub OAuth App (https://github.com/settings/developers)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Google OAuth (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Sign in with Apple (Services ID + Sign in with Apple private key)
# Leave all four values empty to disable the provider locally.
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# Device Code Flow — comma-separated allowed client IDs
DEVICE_CLIENT_IDS=alook-cli
