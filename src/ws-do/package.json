{
  "name": "@alook/ws-do",
  "version": "0.1.64",
  "private": true,
  "scripts": {
    "dev": "node ../../scripts/dev-with-wrangler-registry.mjs ../../.wrangler/registry wrangler dev --persist-to ../web/.wrangler/state",
    "deploy": "wrangler deploy",
    "knip": "knip",
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "test:runtime": "vitest run --config vitest.runtime.config.mts",
    "build": "wrangler deploy --dry-run --outdir dist"
  },
  "dependencies": {
    "@alook/shared": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.4.7",
    "@cloudflare/workers-types": "^5.20261023.1",
    "@types/node": "^25.9.4",
    "knip": "^6.32.2",
    "typescript": "^6.0.3",
    "vitest": "5.1.0",
    "wrangler": "4.152.0"
  }
}
