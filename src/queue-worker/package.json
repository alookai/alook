{
  "name": "@alook/queue-worker",
  "version": "0.1.72",
  "private": true,
  "scripts": {
    "dev": "node ../../scripts/dev-with-wrangler-registry.mjs ../../.wrangler/registry wrangler dev --persist-to ../web/.wrangler/state",
    "deploy": "wrangler deploy",
    "knip": "knip",
    "lint": "eslint src/ test-runtime/ --max-warnings=0",
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc --noEmit",
    "test:runtime": "vitest run --config vitest.runtime.config.mts",
    "build": "wrangler deploy --dry-run --outdir dist"
  },
  "dependencies": {
    "@alook/shared": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.8.5",
    "@cloudflare/workers-types": "^5.20261119.1",
    "@types/node": "^25.9.4",
    "knip": "^6.32.2",
    "eslint": "^9.39.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "5.1.1",
    "wrangler": "4.165.0"
  }
}
